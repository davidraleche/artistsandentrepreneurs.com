ta-contrast=\"auto\">,\u00a0<\/span><b><span data-contrast=\"auto\">Matthew Brown\u00a0Gallery<\/span><\/b><span data-contrast=\"auto\">,\u00a0<\/span><b><span data-contrast=\"auto\">143 Franklin<\/span><\/b><span data-contrast=\"auto\">, and\u00a0<\/span><b><span data-contrast=\"auto\">Canal Projects<\/span><\/b><span data-contrast=\"auto\">, and her work has been featured in publications including\u00a0<\/span><b><i><span data-contrast=\"auto\">The New\u00a0York Times,\u00a0Designboom, Wallpaper*, Hyperallergic,\u00a0Ocula\u00a0Magazine,<\/span><\/i><\/b><i><span data-contrast=\"auto\">\u00a0<\/span><\/i><span data-contrast=\"auto\">and\u00a0<\/span><b><i><span data-contrast=\"auto\">The Art Newspaper<\/span><\/i><\/b><span data-contrast=\"auto\">&#8230;&#8230;<\/span><\/p>\n<p>&nbsp;<\/p>\n<p>[\/et_pb_blurb][et_pb_button button_url=&#8221;https:\/\/artistsandentrepreneurs.com\/architectual-designer-beatriz-de-una-boveda\/&#8221; button_text=&#8221;Read More&#8221; button_alignment=&#8221;center&#8221; _builder_version=&#8221;4.27.4&#8243; _module_preset=&#8221;default&#8221; custom_button=&#8221;on&#8221; button_text_color=&#8221;#ffffff&#8221; button_bg_color=&#8221;#34db34&#8243; button_border_color=&#8221;rgba(0,0,0,0)&#8221; button_icon_color=&#8221;#7cda24&#8243; background_layout=&#8221;dark&#8221; custom_padding=&#8221;||0px|||&#8221; global_colors_info=&#8221;{}&#8221;][\/et_pb_button][\/et_pb_column][\/et_pb_row][et_pb_row column_structure=&#8221;1_4,1_4,1_4,1_4&#8243; admin_label=&#8221;Newsletter Area&#8221; _builder_version=&#8221;4.16&#8243; locked=&#8221;off&#8221; global_colors_info=&#8221;{}&#8221;][et_pb_column type=&#8221;1_4&#8243; _builder_version=&#8221;4.27.4&#8243; _module_preset=&#8221;default&#8221; global_colors_info=&#8221;{}&#8221;][et_pb_blurb title=&#8221;Testimonial&#8221; url=&#8221;https:\/\/artistsandentrepreneurs.com\/architectural-photographer-gunner-gu\/&#8221; image=&#8221;https:\/\/artistsandentrepreneurs.com\/wp-content\/up